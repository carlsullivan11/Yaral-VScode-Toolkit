rule ics_remote_access_to_plc {

  meta:
    author = "Detection Engineering"
    description = "Detects Modbus/TCP connections to PLCs from hosts that are not approved engineering workstations"
    rule_id = "mr_5b6c7d8e-9f0a-4b1c-8d2e-3f4a5b6c7d8e"
    rule_name = "Unapproved Host Connecting To PLC"
    severity = "High"
    priority = "High"
    type = "alert"
    tactic = "TA0108, TA0109"
    technique = "T0886"

  events:
    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.target.port = 502
    $conn.target.ip in %ics_plc_addresses
    not $conn.principal.ip in %ics_engineering_workstations
    $conn.target.ip = $plc_ip

  match:
    $plc_ip over 15m

  outcome:
    $risk_score = max(85)
    $event_count = count_distinct($conn.metadata.id)
    $principal_ip = array_distinct($conn.principal.ip)
    $target_ip = array_distinct($conn.target.ip)

  condition:
    $conn
}
